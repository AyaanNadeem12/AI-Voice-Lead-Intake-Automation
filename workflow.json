      "parameters": {
        "jsCode": "const rawContent = $input.first().json.choices[0].message.content;\n\n// Extract just the JSON object, ignoring any preamble/postamble text or markdown fences\nconst jsonMatch = rawContent.match(/\\{[\\s\\S]*\\}/);\nif (!jsonMatch) {\n  throw new Error('No JSON object found in LLM response: ' + rawContent);\n}\n\nconst parsed = JSON.parse(jsonMatch[0]);\n\nconst webhookData = $('Webhook').first().json.body;\n\nreturn [{\n  json: {\n    caller_name: webhookData.caller_name,\n    phone_number: webhookData.phone_number,\n    caller_email: webhookData.caller_email,\n    issue_description: webhookData.issue_description,\n    urgency: webhookData.urgency,\n    urgency_check: parsed.urgency_check,\n    preferred_callback_time: webhookData.preferred_callback_time,\n    service_area: webhookData.service_area,\n    ai_summary: parsed.summary,\n    timestamp: new Date().toISOString()\n  }\n}];"
